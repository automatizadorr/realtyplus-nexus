    {
      "parameters": {
        "functionCode": "var items = $input.all();\nvar total = items.length;\nvar conteo = {};\n\nitems.forEach(function(item) {\n  var etiqueta = item.json.etiqueta || 'Sin etiqueta';\n  conteo[etiqueta] = (conteo[etiqueta] || 0) + 1;\n});\n\nvar emojis = {\n  'Lead Caliente': '🔥',\n  'Cita agendada': '📅',\n  'Interesado en Financiamiento': '💰',\n  'Listo para Cerrar': '✅',\n  'Solo Consultando': '🏡',\n  'Requiere Seguimiento IA': '👋',\n  'Conversación Activa': '😊',\n  'Sin Respuesta al Bot': '📵'\n};\n\nvar lineas = Object.keys(conteo).map(function(e) {\n  return (emojis[e] || '•') + ' ' + e + ': *' + conteo[e] + '*';\n}).join('\\n');\n\nvar fecha = new Date().toLocaleString('es-MX', {timeZone: 'America/Mexico_City'});\n\nvar resumen = '📊 *Reporte Clasificación IA*\\n🕐 ' + fecha + '\\n\\nMensajes enviados: *' + total + '*\\n\\n' + lineas + '\\n\\n_Próxima clasificación en 5h_';\n\nreturn [{json: {resumen: resumen, total: total}}];"
      },
