      "parameters": {
        "jsCode": "const data = $json;\nconst leads = data.leads || [];\n\nreturn leads.map(lead => {\n  let tel = String(lead.telefono || '');\n  tel = tel.replace('@s.whatsapp.net', '');\n  tel = tel.replace('+', '');\n  tel = tel.replace(/\\D/g, '');\n\n  return {\n    json: {\n      ...lead,\n      telefono_limpio: tel,\n      timestamp_reporte: data.timestamp,\n      total_clasificados: data.leads_clasificados\n    }\n  };\n});"
      },
