    {
      "parameters": {
        "jsCode": "// NEXUS PROTOCOL: Parseador para Mensajes en Partes\nconst items = $input.all();\nlet newItems = [];\n\nfor (const item of items) {\n  let rawOutput = item.json.output || item.json.text || \"\";\n  let parsedMessages = [];\n\n  if (typeof rawOutput === 'string') {\n    rawOutput = rawOutput.replace(/```json/gi, \"\").replace(/```/g, \"\").trim();\n  }\n\n  function extractJsonFromString(str) {\n    const jsonMatch = str.match(/\\{[\\s\\S]*\\}/s);\n    if (jsonMatch) {\n      try { return JSON.parse(jsonMatch[0]); } catch(e) { return null; }\n    }\n    return null;\n  }\n\n  try {\n    let jsonData = typeof rawOutput === 'string' ? JSON.parse(rawOutput) : rawOutput;\n    if (jsonData.messages && Array.isArray(jsonData.messages)) {\n      parsedMessages = jsonData.messages.map(m => m.text || m.mensaje || \"\");\n    } else { parsedMessages = [rawOutput]; }\n  } catch (error) {\n    if (typeof rawOutput === 'string') {\n      const extracted = extractJsonFromString(rawOutput);\n      if (extracted) {\n        if (extracted.messages && Array.isArray(extracted.messages)) {\n          parsedMessages = extracted.messages.map(m => m.text || m.mensaje || \"\");\n        } else { parsedMessages = [rawOutput]; }\n      } else { parsedMessages = [rawOutput]; }\n    } else { parsedMessages = [rawOutput]; }\n  }\n\n  parsedMessages = parsedMessages.filter(m => m && m.trim() !== \"\");\n\n  for (let i = 0; i < parsedMessages.length; i++) {\n    let delay = 1;\n    if (i > 0) { delay = Math.max(2, Math.floor(parsedMessages[i-1].length / 30)); }\n    newItems.push({ json: { ...item.json, text_to_send: parsedMessages[i], delay_seconds: delay, message_index: i + 1, total_messages: parsedMessages.length } });\n  }\n}\n\nreturn newItems;"
      },
