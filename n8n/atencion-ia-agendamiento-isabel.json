        "jsCode": "// NEXUS PROTOCOL: Parseador + Interceptor de Reservas v2\nconst items = $input.all();\n\nfor (const item of items) {\n  let rawOutput = item.json.output || item.json.text || \"\";\n  let parsedMessages = [];\n  let reservaData = null;\n\n  if (typeof rawOutput === 'string') {\n    rawOutput = rawOutput.replace(/```json/gi, \"\").replace(/```/g, \"\").trim();\n  }\n\n  function extractJsonFromString(str) {\n    const jsonMatch = str.match(/\\{[\\s\\S]*\\}/s);\n    if (jsonMatch) { try { return JSON.parse(jsonMatch[0]); } catch(e) { return null; } }\n    return null;\n  }\n\n  try {\n    let jsonData = typeof rawOutput === 'string' ? JSON.parse(rawOutput) : rawOutput;\n    if (jsonData.messages && Array.isArray(jsonData.messages)) { parsedMessages = jsonData.messages.map(m => m.text || m.mensaje || \"\"); } else { parsedMessages = [rawOutput]; }\n    if (jsonData.reserva && jsonData.reserva.email) { reservaData = jsonData.reserva; }\n  } catch (error) {\n    if (typeof rawOutput === 'string') {\n      const extracted = extractJsonFromString(rawOutput);\n      if (extracted) {\n        if (extracted.messages && Array.isArray(extracted.messages)) { parsedMessages = extracted.messages.map(m => m.text || m.mensaje || \"\"); } else { parsedMessages = [rawOutput]; }\n        if (extracted.reserva && extracted.reserva.email) { reservaData = extracted.reserva; }\n      } else { parsedMessages = [rawOutput]; }\n    } else { parsedMessages = [rawOutput]; }\n  }\n\n  item.json.mensaje_1 = parsedMessages[0] || \"\";\n  item.json.mensaje_2 = parsedMessages[1] || \"\";\n  item.json.mensaje_3 = parsedMessages[2] || \"\";\n  item.json.datos_reserva = reservaData;\n  delete item.json.output;\n}\n\nreturn items;"
      },
